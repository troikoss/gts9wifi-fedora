[Unit]
Description=Wake the gts9wifi display on the touchscreen's double tap
# Sleep mode is a per-user setting, so this follows the user session it was
# turned on in, like gts9wifi-power-key-watch.service does.
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/libexec/gts9wifi-wake-gesture
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
