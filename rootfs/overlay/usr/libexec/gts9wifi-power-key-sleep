#!/bin/sh
# SPDX-License-Identifier: MIT
#
# Put the tablet to sleep: lock the session and turn the screen off, leaving the
# system running.  This is the power key's action in sleep mode - see
# gts9wifi-power-key-watch, which points the key here while the display is on and
# at gts9wifi-power-key-wake while it is off.
#
# Locking is what turns the screen off with it: gnome-settings-daemon blanks the
# displays as soon as the screen shield becomes active, the same path GNOME takes
# when it blanks on idle.  At the lock screen the shield is already up and there
# is no such change, so the displays are blanked directly through Mutter instead.
#
# Either way the tablet keeps running, so its Wi-Fi link and remote access
# survive, where a suspend would drop both.
set -u

# The tablet keeps running, so its wireless link stays up: put that link to sleep
# as well, both here and, for the case where no power key is involved, from the
# watcher.  The wake action puts it back.
lowpower=/usr/libexec/gts9wifi-power-key-lowpower

display_config=org.gnome.Mutter.DisplayConfig
display_path=/org/gnome/Mutter/DisplayConfig

# With the display off the controller only notices a touch through its
# double-tap gesture, and the wake key it reports is what brings the display
# back.  The gesture is armed here and disarmed on the way back; the watcher
# keeps it in step with the display afterwards.  It does nothing unless double
# tap to wake is on, or if this kernel does not have the attribute yet.
gesture=/sys/bus/i2c/devices/10-0049/wake_gesture
gesture_arm() {
	[ -w "$gesture" ] && printf '%s' "$1" >"$gesture"
	true
}

display_power() {
	busctl --user get-property "$display_config" "$display_path" \
		"$display_config" PowerSaveMode 2>/dev/null
}

# Already blanked: this press is the way back, not another sleep.  The watcher
# normally points the key at the wake action by now, so this only matters in the
# moment before it notices - and then the display has to come back, never blank
# again, or the tablet could not be woken with the power button.
case "$(display_power)" in
*i\ [123])
	gesture_arm 0
	busctl --user set-property "$display_config" "$display_path" \
		"$display_config" PowerSaveMode i 0 2>/dev/null || true
	"$lowpower" off 2>/dev/null || true
	exit 0
	;;
esac

# loginctl delivers this to the session, where gnome-shell shows the screen
# shield and gnome-settings-daemon follows by blanking the displays.
loginctl lock-session 2>/dev/null || true

# If the shield was already up nothing changed and nothing blanked, so blank the
# displays ourselves.  Mutter exposes this and ignores a value of -1, which means
# the output cannot be blanked that way at all.
case "$(display_power)" in
*i\ 0)
	busctl --user set-property "$display_config" "$display_path" \
		"$display_config" PowerSaveMode i 3 2>/dev/null || true
	;;
esac

gesture_arm 1
"$lowpower" on 2>/dev/null || true

exit 0
